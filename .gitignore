# ==============================================================================
# Unity 2D Project - Git Ignore
# Unity 2022.3.13f1c1 (2D / URP)
# 只跟踪 Assets/、Packages/、ProjectSettings/ 三个目录（以及少量根目录配置文件）
# ==============================================================================

# ------------------------------------------------------------------------------
# Unity 自动生成的目录（绝不提交）
# ------------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 下载的包（体积大，可用 Package Manager 重新导入）
/[Aa]ssets/AssetStoreTools*

# Addressables / 构建产物缓存
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ------------------------------------------------------------------------------
# Unity 生成的文件
# ------------------------------------------------------------------------------
# 由 Unity 根据 Assets 内容自动生成的解决方案/工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 项目本次使用的 .vsconfig 由编辑器/VS 维护，如需团队共享可自行取消忽略
# .vsconfig

# ------------------------------------------------------------------------------
# 构建产物
# ------------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
ExportedObj/
.consulo/

# 平台特殊产物
*.x86
*.x86_64
*.exe
*.dll.mdb

# ------------------------------------------------------------------------------
# Visual Studio / Rider / VS Code
# ------------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.sln.DotSettings.user

# ------------------------------------------------------------------------------
# Mono / .NET
# ------------------------------------------------------------------------------
*.pidb
*.mdb
*.opendb
*.sln.docstates
packages/
!Packages/
TestResults/
*.trx
*.obj
*.pdb
*.nupkg

# ------------------------------------------------------------------------------
# OS 生成的文件
# ------------------------------------------------------------------------------
# Windows
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
Thumbs.db

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
*.swp
*~

# ------------------------------------------------------------------------------
# 动态库 / 插件（按需保留）
# 如果你需要把第三方原生插件提交进仓库，请删除下面两行
# ------------------------------------------------------------------------------
# *.dll
# *.so

# ------------------------------------------------------------------------------
# 已知问题绕过：部分工具会在 Assets 下生成临时文件
# ------------------------------------------------------------------------------
/[Aa]ssets/**/*.svn/
/[Aa]ssets/**/.DS_Store
